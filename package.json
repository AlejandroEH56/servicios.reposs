{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "openapi:lint": "redocly lint api management --format stylish",
        "openapi:bundle": "redocly bundle api --output artifacts/api.yaml && redocly bundle management --output artifacts/management.yaml",
        "gate": "node scripts/pre-sprint1-gate.mjs",
        "test:gate": "node --test scripts/pre-sprint1-gate.test.mjs",
        "test:e2e": "playwright test",
        "test:tls": "node --test tests/Browser/tls-stage.test.mjs"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@redocly/cli": "2.57.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "10.0.5",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "engines": {
        "npm": "11.17.x",
        "node": "24.19.x"
    },
    "overrides": {
        "shell-quote": "1.12.0"
    }
}
