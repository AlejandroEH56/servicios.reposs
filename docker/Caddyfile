{
    admin off
    skip_install_trust
    https_port 8443
    auto_https disable_redirects
}
:80 {
    redir {$CANONICAL_ORIGIN}{uri} 308
}
{$SITE_ADDRESS} {
    {$TLS_DIRECTIVE}
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    @portalAssets path_regexp portalAssets ^/portal/.*\.(js|css|ico|png|svg|woff2|woff|ttf|map)$
    handle @portalAssets {
        uri strip_prefix /portal
        root * /srv/frontend
        file_server
    }
    handle /portal/* {
        root * /srv/app/public
        rewrite * /index.php
        php_fastcgi backend:9000 {
            trusted_proxies private_ranges
        }
    }
    handle {
        root * /srv/app/public
        php_fastcgi backend:9000 {
            trusted_proxies private_ranges
        }
        file_server
    }
}
