<!doctype html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <title>Constancia</title>
    <style>
        @page {
            margin: 22px 28px;
        }

        body {
            font-family: "Times New Roman", Times, serif;
            font-size: 11pt;
            color: #000;
        }

        .center {
            text-align: center;
        }

        .upper {
            text-transform: uppercase;
        }

        .bold {
            font-weight: bold;
        }

        .logos {
            width: 100%;
            table-layout: fixed;
            border-collapse: separate;
            border-spacing: 16px 0;
            margin-bottom: 6px;
        }

        .logos td {
            padding: 0;
            height: 70px;
            text-align: center;
            vertical-align: middle;
        }

        .logos img {
            display: inline-block;
            height: 50px;
            max-width: 100%;
            vertical-align: middle;
        }

        .h1 {
            font-size: 12pt;
        }

        .h2 {
            font-size: 11pt;
        }

        .hConstancia {
            font-size: 18pt;
            letter-spacing: .5px;
        }

        .hName {
            font-size: 16pt;
        }

        .parrafo {
            font-size: 10.5pt;
            line-height: 1.15;
            text-align: justify;
        }

        /* ======== Tabla principal ======== */
        table.main {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-top: 10px;
            font-size: 10pt;
        }

        table.main th,
        table.main td {
            border: 1px solid #333;
            padding: 6px 6px;
            vertical-align: top;
        }

        table.main thead th {
            background: #d9d9d9;
            text-align: center;
            font-weight: bold;
        }

        table.main col.c1 {
            width: 21%;
        }

        table.main col.c2 {
            width: 20%;
        }

        table.main col.c3 {
            width: 33%;
        }

        table.main col.c4 {
            width: 26%;
        }

        /* ======== Firmas ======== */
        .firmas {
            width: 100%;
            margin-top: 100px;
            border-collapse: collapse;
        }

        .firmas td {
            width: 50%;
            text-align: center;
            vertical-align: top;
            padding-top: 25px;
        }

        .firma-nombre {
            font-weight: bold;
            font-size: 10pt;
        }

        .firma-cargo {
            font-size: 9pt;
        }

        /* ======== Página 2 ======== */
        .page-break {
            page-break-before: always;
        }

        .page2-wrap {
            margin-top: 380px;
        }

        table.registro {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: 10pt;
            margin-top: 18px;
        }

        table.registro th {
            border: 1px solid #333;
            padding: 10px 8px;
            text-align: center;
            height: 90px;
        }

        table.registro tbody td {
            border: 1px solid #333;
            padding: 18px 8px;
            text-align: center;
            height: 180px;
            vertical-align: middle;
        }

        table.registro thead th {
            background: #fff;
            font-weight: bold;
            height: auto;
        }
    </style>
</head>

<body class="upper">

    <!-- ======== Logos dinámicos desde BD ======== -->
