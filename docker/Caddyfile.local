{
    admin off
    auto_https disable_redirects
    skip_install_trust
    persist_config off
    storage file_system {
        root {$CADDY_STORAGE_ROOT}
    }
}
{$LOCAL_SITE_ADDRESS} {
    tls internal
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    handle_path /portal/* {
        root * {$FRONTEND_ROOT}
        try_files {path} /index.html
        file_server
    }
    handle {
        reverse_proxy {$LOCAL_BACKEND}
    }
}
