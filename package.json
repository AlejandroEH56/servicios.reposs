{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "openapi:lint": "redocly lint api management --format stylish",
    "openapi:bundle": "redocly bundle api --output artifacts/api.yaml && redocly bundle management --output artifacts/management.yaml",
    "gate": "node scripts/pre-sprint1-gate.mjs",
    "test:gate": "node --test scripts/pre-sprint1-gate.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.57.0",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "engines": {
    "npm": "11.17.x",
    "node": "24.19.x"
  }
}
